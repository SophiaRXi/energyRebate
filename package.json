{
  "name": "energyrebate",
  "version": "1.0.0",
  "description": "Rebate eligibility and stackability engine using Epilog logic",
  "main": "backend/server.js",
  "scripts": {
    "fetch:energystar": "python3 scripts/fetch_energystar.py",
    "import:energystar": "python3 scripts/import_energystar.py",
    "enrich:retail": "python3 scripts/enrich_retail.py --apply-db",
    "enrich:retail:seed": "python3 scripts/enrich_retail.py --seed-only --apply-db",
    "build:db": "python3 scripts/build_db.py",
    "build:all": "npm run fetch:energystar && npm run import:energystar && npm run build:db && npm run enrich:retail:seed",
    "start": "node backend/server.js",
    "test": "node test/engine.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SophiaRXi/energyRebate.git"
  },
  "keywords": [
    "epilog",
    "rebates",
    "logic-programming"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SophiaRXi/energyRebate/issues"
  },
  "homepage": "https://github.com/SophiaRXi/energyRebate#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  }
}